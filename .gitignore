# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets ignored, template preserved)
.env*.local
.env
.env.*
!.env.example
!backend/.env.example

# python / virtualenvs / caches
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# scratch / release archives / audit reports
scratch/
*.zip
STAGE_*/
audit_reports/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
