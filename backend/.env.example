# Skill Mantra Academy - FastAPI Backend Configuration
# Supported Python Runtime: Python 3.10+ (tested on Python 3.10.0)

# Environment: 'development', 'staging', or 'production'
ENVIRONMENT=development
DEBUG=true

# Application Core Settings
APP_NAME="Skill Mantra Academy Backend"
API_V1_PREFIX="/api/v1"
SECRET_KEY="replace_with_a_secure_random_64_character_hex_string_in_production"

# Database Configuration (PostgreSQL 15+ hosted on Neon)
# Standard connection format: postgresql+psycopg://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql+psycopg://username:password@ep-example-endpoint.us-east-2.aws.neon.tech/skillmantra?sslmode=require

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_ECHO=false

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Reverse Proxy / Ingress Trust Configuration (comma-separated list of trusted proxy IPs/CIDRs)
# When set, X-Forwarded-For is evaluated right-to-left until the first untrusted hop.
# If the direct peer is not in this list, X-Forwarded-For is ignored entirely.
TRUSTED_PROXIES="127.0.0.1,::1"

# Session Lifetime Configuration
SESSION_DURATION_DAYS=7
SESSION_COOKIE_NAME="skillmatra_session"
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE="lax"

