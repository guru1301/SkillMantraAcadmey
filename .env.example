# ==============================================================================
# Skill Mantra Academy / Skill Thinker Platform — Environment Variables
# Stage D: Next.js Frontend + FastAPI Backend Architecture
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration (FastAPI)
# ------------------------------------------------------------------------------
# The base URL of the FastAPI backend service.
# Used by Next.js Server Components, Server Actions, and Middleware for API communication.
FASTAPI_BASE_URL=http://127.0.0.1:8000

# Public URL of the FastAPI service (for client-side browser requests if applicable).
NEXT_PUBLIC_FASTAPI_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# Application Environment & Security
# ------------------------------------------------------------------------------
# Next.js Node environment ('development' | 'production')
NODE_ENV=development

# Trusted client IP header name provided by the hosting platform / CDN (e.g. 'x-real-ip', 'cf-connecting-ip')
TRUSTED_CLIENT_IP_HEADER=x-real-ip

# ------------------------------------------------------------------------------
# Backend PostgreSQL Database (Configured in backend/.env)
# ------------------------------------------------------------------------------
# In Stage D, Next.js does NOT connect directly to the database.
# Database connectivity is managed exclusively by the FastAPI backend.
# See backend/.env.example for backend database configuration:
# DATABASE_URL=postgresql://user:password@localhost:5432/skillmantra
